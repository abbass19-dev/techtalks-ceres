                  <div className="inst-num">{i + 1}</div>
                  <p className="inst-text">{step}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        {/* SIDEBAR */}
        <aside className="sidebar">

          {/* NUTRITION CARD */}
          <div className="nutrition-card">
            <div className="nutrition-header">
              <span className="nutrition-title">Nutritional Info</span>
              <span className="nutrition-serving">Per serving</span>
            </div>
            <div className="nutrition-body">
              <div className="cal-row">
                <div>
                  <div className="cal-big">{recipe.nutrition.calories}</div>
                  <div className="cal-label">Calories (kcal)</div>
                </div>
                <svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
                  <circle cx="24" cy="24" r="20" fill="none" stroke="#f0f0ea" strokeWidth="4"/>
                  <circle cx="24" cy="24" r="20" fill="none" stroke="#C9A84C" strokeWidth="4"
                    strokeDasharray={`${(recipe.nutrition.carbs / (recipe.nutrition.protein + recipe.nutrition.carbs + recipe.nutrition.fat)) * 125.6} 125.6`}
                    strokeDashoffset="31.4" transform="rotate(-90 24 24)" opacity=".6"/>
                  <circle cx="24" cy="24" r="20" fill="none" stroke="#0d1f0d" strokeWidth="4"
                    strokeDasharray={`${(recipe.nutrition.protein / (recipe.nutrition.protein + recipe.nutrition.carbs + recipe.nutrition.fat)) * 125.6} 125.6`}
                    strokeDashoffset="-94.2" transform="rotate(-90 24 24)" opacity=".5"/>
                </svg>
              </div>

              <div className="macro-bars">
