  .macro-val { font-family: 'Cormorant Garamond', serif; font-size: 1rem; font-weight: 400; color: var(--green); }
  .macro-bar-bg { height: 4px; background: #f0f0ea; border-radius: 100px; overflow: hidden; }
  .macro-bar-fill { height: 100%; border-radius: 100px; transition: width .8s cubic-bezier(.22,1,.36,1); }
  .vitamins-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: .6rem;
    margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);
  }
  .vit-item {
    background: var(--gold-faint); border: 1px solid rgba(201,168,76,.15);
    border-radius: 6px; padding: .65rem .75rem;
  }
  .vit-name { font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: #aaa; margin-bottom: 3px; }
  .vit-val { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; font-weight: 400; color: var(--green); }

  /* ── CTA CARD ── */
  .cta-card { background: var(--green); border-radius: 10px; padding: 1.6rem; text-align: center; }
  .cta-title { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 400; color: var(--gold-light); margin-bottom: .4rem; }
  .cta-sub { font-size: 12px; color: var(--sage); font-weight: 300; margin-bottom: 1.3rem; line-height: 1.65; }
  .btn-add {
    width: 100%; padding: 13px; background: var(--gold); color: var(--green);
    border: none; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase; cursor: pointer; border-radius: 4px;
    transition: all .2s; margin-bottom: .75rem;
  }
  .btn-add:hover:not(:disabled) { background: #d4b560; }
  .btn-add:disabled { background: #1a3a1a; color: var(--gold-light); cursor: default; }
  .btn-fav {
    width: 100%; padding: 12px; background: none;
    border: 1px solid rgba(201,168,76,.35); color: var(--gold);
    font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 500;
    letter-spacing: .15em; text-transform: uppercase; cursor: pointer; border-radius: 4px;
    transition: all .2s; display: flex; align-items: center; justify-content: center; gap: 7px;
  }
  .btn-fav:hover { background: rgba(201,168,76,.1); border-color: var(--gold); }
  .btn-fav.active { background: rgba(201,168,76,.15); }

  /* ── LOADING ── */
  .skeleton {
    background: linear-gradient(90deg,#f0f0ea 25%,#e8e8e0 50%,#f0f0ea 75%);
    background-size: 200% 100%; animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer { 0%{background-position:200% 0;} 100%{background-position:-200% 0;} }
  .hero-skeleton { height: 380px; }
  .skeleton-body { padding: 2rem; }
  .sk-line { border-radius: 4px; display: block; }
  .sk-grid { display: grid; grid-template-columns: 1fr 300px; gap: 2rem; margin-top: 1rem; }

  /* ── ERROR ── */
  .error-state { text-align: center; padding: 5rem 2rem; }
  .error-icon { font-size: 3.5rem; margin-bottom: 1rem; }
  .error-title { font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; color: var(--green); margin-bottom: .5rem; }
  .error-msg { font-size: 13px; color: #aaa; margin-bottom: 1.5rem; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .hero { height: 260px; }
    .hero-title { font-size: 1.8rem; }
    .quick-stats { grid-template-columns: repeat(2,1fr); }
    .page-body { grid-template-columns: 1fr; padding: 1.5rem 1rem; gap: 0; }
    .sidebar { margin-top: 2rem; }
    .sk-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .hero-content { padding: 1.5rem 1rem 1.2rem; }
    .hero-title { font-size: 1.5rem; }
    .hero-desc { display: none; }
    .page-body { padding: 1rem; }
  }
`;
