                <div className="macro-card" key={m.label}>
                  <div className="macro-label">{m.label}</div>
                  <input className="macro-input" type="number" placeholder="0" value={m.val} onChange={(e) => m.set(e.target.value)} />
                  <div className="macro-unit">{m.unit}</div>
                </div>
              ))}
            </div>

            {/* INSTRUCTIONS */}
            <div className="sec-div"><span>Instructions</span></div>

            {instructions.map((step, idx) => (
              <div className="instruction-row" key={step.id}>
                <div className="step-circle">{idx + 1}</div>
                <div className="field" style={{ flex: 1, margin: 0 }}>
                  <div className="fl-wrap">
                    <textarea className="fl-textarea" rows={2} placeholder="Describe this step..." value={step.text} onChange={(e) => updateInstruction(step.id, e.target.value)} />
                    <span className="underline" />
                  </div>
                </div>
                {instructions.length > 1 && (
                  <button className="remove-btn" onClick={() => removeInstruction(step.id)} type="button" style={{ marginTop: "10px" }}>×</button>
                )}
              </div>
            ))}
            <button className="add-btn" onClick={addInstruction} type="button">+ Add Step</button>

            {/* SUBMIT */}
            <div className="submit-area">
              <button className="btn-secondary" type="button">Cancel</button>
              <div style={{ display: "flex", gap: "10px" }}>
                <button className="btn-save-draft" type="button">Save Draft</button>
                <button className="btn-primary" onClick={handleSubmit} disabled={loading} type="button">
                  {loading ? "Publishing..." : "Publish Recipe →"}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}
